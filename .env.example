# DreamTeam Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ── Required ──────────────────────────────────────────────

# SOPS Age Key for decrypting secrets
# Generate with: age-keygen -o config/age-key.txt
SOPS_AGE_KEY_FILE=./config/age-key.txt

# ── Optional ──────────────────────────────────────────────

# Node environment (development | production)
NODE_ENV=development

# Remote access IP (Tailscale, LAN, etc.) for accessing dev servers
# Used by Playwright config and smoke tests. Defaults to localhost.
TAILSCALE_IP=localhost

# Override default models (defaults: haiku, sonnet, opus)
# DREAMTEAM_MODEL_PRIMARY=opus
# DREAMTEAM_MODEL_SECONDARY=sonnet
# DREAMTEAM_MODEL_ANCILLARY=haiku

# Override CLI command (default: claude)
# DREAMTEAM_CLI_COMMAND=claude

# ── Code Review Settings ─────────────────────────────────
# Review backend: auto (default), claude-code, or legacy
# auto = small diffs use legacy Sonnet, large diffs use Claude Code Review
DREAMTEAM_REVIEW_BACKEND=claude-code

# Run both review backends in parallel for complex/auth goals (1 to enable)
DREAMTEAM_REVIEW_DUAL_GATE=1

# Auto-create GitHub PRs with review findings for rejected goals (1 to enable)
DREAMTEAM_REVIEW_CREATE_PR=1

# ── Langfuse Tracing (optional) ─────────────────────────
# Enable structured observability for agent executions.
# Sign up at https://cloud.langfuse.com — traces are no-ops when not set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
