{
  "name": "dreamteam",
  "version": "0.1.0",
  "description": "Autonomous multi-project orchestration system — manage AI coding agents from your phone via Telegram",
  "license": "MIT",
  "author": "DreamTeam Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/gocon-loca/dreamteam-ai"
  },
  "homepage": "https://github.com/gocon-loca/dreamteam-ai#readme",
  "keywords": [
    "ai",
    "automation",
    "claude",
    "orchestration",
    "agents",
    "telegram",
    "autonomous-coding"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot/index.js",
    "dev": "tsx watch src/bot/index.ts",
    "test": "tsc -p tests/tsconfig.json && node dist-tests/unit/core-modules.test.js && node dist-tests/unit/integration.test.js",
    "test:e2e": "npx playwright test",
    "supervisor": "node dist/daemon/supervisor.js",
    "worker": "node dist/daemon/worker.js",
    "setup": "tsx scripts/setup.ts",
    "setup:web": "tsx scripts/setup-web.ts",
    "goal": "tsx src/cli/goal.ts",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@hono/node-server": "^1.19.10",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.12.7",
    "langfuse": "^3.38.6",
    "openai": "^6.18.0",
    "telegraf": "^4.16.3",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}